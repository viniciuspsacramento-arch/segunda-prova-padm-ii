# Copie para .env local (não commitar .env)

PORT=3000

# MySQL
DB_HOST=localhost
DB_USER=root
DB_PASSWORD=
DB_NAME=banco_questoes_estatistica

# Admin
ADMIN_PASSWORD=

# Login admin em 2 etapas (senha + código no Telegram)
TELEGRAM_BOT_TOKEN=
TELEGRAM_ADMIN_CHAT_ID=

# SMTP (resultado da prova + alertas de compartilhamento)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
PROFESSOR_EMAIL=
# Conta Microsoft do professor para ver planilhas dos alunos (se diferente do e-mail SMTP acima)
MICROSOFT_PROFESSOR_EMAIL=

# Triangulação (só análise no histórico admin — não bloqueia alunos na prova)
CAMPUS_CIDADES=Juazeiro do Norte,Crato
TRIANGULACAO_MIN_CLUSTER=3
# GPS: obrigatório para iniciar prova; usado só na triangulação (não bloqueia durante a prova)
EXIGIR_GPS_PROVA=true
CAMPUS_GPS_PONTOS=-7.2137,-39.3153;-7.2339,-39.4094
CAMPUS_GPS_RAIO_KM=35
# Prefixos de rede do lab UFCA (opcional, melhora detecção de sala)
# ALUNO_ALLOWED_IP_PREFIXES=200.17.,177.87.
MICROSOFT_CLIENT_ID=
MICROSOFT_TENANT_ID=common
# URI SPA exata no Azure (sem barra no final). Deve ser o mesmo Client ID do app.
MICROSOFT_REDIRECT_URI=https://prova-final-adm-production.up.railway.app/auth/microsoft.html
